{
  "name": "pet-vet",
  "productName": "PetVet (Pro)",
  "version": "5.0.10",
  "description": "This is a Desktop application for a Vet Management System",
  "license": "MIT",
  "author": "hifi",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.petvet.pro",
    "productName": "PetVet (Pro)",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "app-icon.png",
      "server.js",
      "generate_invoice.js",
      "boardingSummaryPDF.js",
      "consentForm.js",
      "consentPolicyText.js",
      "handlers/**/*",
      "pet-vet/**/*",
      "node_modules/**/*",
      "package.json",
      ".env"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": null,
      "uninstallerIcon": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PetVet (Pro)"
    },
    "portable": {
      "artifactName": "PetVet-${version}-portable.exe"
    }
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.1",
    "electron-log": "^5.4.4",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "image-size": "^2.0.2",
    "jspdf": "^3.0.2",
    "mysql2": "^3.14.3",
    "pdfkit": "^0.18.0",
    "toastify-js": "^1.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^25.1.8"
  }
}
